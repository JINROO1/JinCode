{
  "name": "jincode-cli",
  "version": "0.1.0",
  "description": "JinCode terminal client: a full-screen interface over the DeepSeek Harness Remote API",
  "private": true,
  "type": "module",
  "bin": {
    "jincode": "./src/cli.tsx"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
