diff --git a/packages/client/ui-layout/src/client/MobileFrame.module.css b/packages/client/ui-layout/src/client/MobileFrame.module.css
new file mode 100644
index 00000000..7a7f4de4
--- /dev/null
+++ b/packages/client/ui-layout/src/client/MobileFrame.module.css
@@ -0,0 +1,155 @@
+/**
+ * Mobile-first shell styles. See MobileFrame.tsx for the layout guarantees.
+ * Theme tokens are the shared deepsuite variables the desktop frame uses, so
+ * the mobile shell inherits the active palette without a second theme.
+ */
+
+.frame {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  /* dvh first so it wins where supported; the vh line is the fallback when
+     dvh is unknown to the engine. The component also sets an inline height
+     (dvh or calc(vh - keyboard)) which overrides both. */
+  height: 100vh;
+  height: 100dvh;
+  box-sizing: border-box;
+  overflow: hidden;
+  background: var(--dsw-alias-bg-base);
+  /* Reserve a little room so any fixed bottom content in a pane clears the
+     bottom navigation rather than sliding under it. */
+  padding-bottom: env(safe-area-inset-bottom, 0px);
+}
+
+.topBar {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: center;
+  min-height: 48px;
+  padding: calc(env(safe-area-inset-top, 0px) + 8px) 16px 8px;
+  background: var(--dsw-specific-sidebar-fill);
+  border-bottom: 0.5px solid var(--dsw-alias-border-l3);
+}
+
+.title {
+  flex: 1 1 auto;
+  min-width: 0;
+  font-size: 15px;
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* The single scrolling surface. Each pane is a flex child that can shrink in
+   both axes (the cause of text "piling up" / being clipped) and scrolls only
+   within itself. */
+.main {
+  flex: 1 1 auto;
+  min-height: 0;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.tabPane {
+  display: none;
+  flex: 1 1 auto;
+  min-height: 0;
+  min-width: 0;
+  flex-direction: column;
+  overflow: auto;
+  overscroll-behavior: contain;
+  /* Long descriptions / tool output never overflow their pane. */
+  overflow-wrap: break-word;
+  word-break: break-word;
+}
+
+.tabPane[data-active] {
+  display: flex;
+}
+
+/* The conversation owns its internal scroll; avoid a second scrollbar. */
+.chatPane {
+  overflow: hidden;
+}
+
+.mainPanel {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-width: 0;
+  min-height: 0;
+}
+
+.overlayLayer {
+  position: absolute;
+  inset: 0;
+  z-index: 30;
+  pointer-events: none;
+}
+
+.overlayLayer > * {
+  pointer-events: auto;
+}
+
+/* Bottom navigation: sits below the content, above the system nav / home
+   indicator, and never under the soft keyboard. */
+.bottomNav {
+  flex: 0 0 auto;
+  display: flex;
+  gap: 2px;
+  padding: 6px 8px calc(env(safe-area-inset-bottom, 0px) + 6px);
+  background: var(--dsw-specific-sidebar-fill);
+  border-top: 0.5px solid var(--dsw-alias-border-l3);
+}
+
+.navItem {
+  flex: 1 1 0;
+  min-width: 0;
+  min-height: 48px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  padding: 6px 4px;
+  border: none;
+  border-radius: 10px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  cursor: pointer;
+  /* No double-tap zoom, no pull gestures interfering with the nav. */
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.navItem[data-active] {
+  background: color-mix(in srgb, currentColor 10%, transparent);
+  font-weight: 600;
+}
+
+.navIcon {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 0;
+}
+
+.navLabel {
+  font-size: 11px;
+  line-height: 1.2;
+  min-width: 0;
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .navItem {
+    transition: none;
+  }
+}
diff --git a/packages/client/ui-layout/src/client/MobileFrame.tsx b/packages/client/ui-layout/src/client/MobileFrame.tsx
new file mode 100644
index 00000000..73f2ff87
--- /dev/null
+++ b/packages/client/ui-layout/src/client/MobileFrame.tsx
@@ -0,0 +1,177 @@
+/**
+ * Mobile-first shell for the root slot, used when the frame is narrow (phone /
+ * narrow tablet). It swaps the three-column AppFrame for a tabbed,
+ * bottom-navigation shell that reuses the exact same child slots:
+ *
+ *  - `chat`        → the `main` slot (the Conversation / active panel)
+ *  - `conversations` → the `sidebar` slot (session list), full width
+ *  - `files`       → the `rightbar` slot (files / terminal / previews), full width
+ *
+ * Layout guarantees (the reason this shell exists):
+ *  - The frame uses `100dvh` so the soft keyboard reflows the layout instead of
+ *    covering the bottom navigation; a `visualViewport` fallback adds the
+ *    keyboard inset to the nav's bottom padding on engines without `dvh`.
+ *  - Every scroll surface is its own flex child with `min-height: 0` /
+ *    `min-width: 0` and `overscroll-behavior: contain`, so long descriptions
+ *    and tool output scroll inside their pane instead of pushing or truncating
+ *    the chrome.
+ *  - All edges pad by `env(safe-area-inset-*)` so the device navigation bar,
+ *    notch and home indicator never cover the UI.
+ *  - Text containers use `overflow-wrap: anywhere` so words never overflow.
+ *  - Primary targets are ≥ 48px with `touch-action: manipulation`.
+ *
+ * The root registration chooses this shell over AppFrame through RootFrame.
+ */
+import { useEffect, useRef, useState, type CSSProperties } from 'react'
+import type { AppFrameProps } from './AppFrame.tsx'
+import { DocumentTitle } from './DocumentTitle.tsx'
+import css from './MobileFrame.module.css'
+
+/** Tabs of the mobile shell, in bottom-navigation order. */
+type MobileTab = 'chat' | 'conversations' | 'files'
+
+/** Read the soft-keyboard height from the visual viewport (0 when unsupported). */
+function useKeyboardInset(): number {
+  const [inset, setInset] = useState(0)
+  useEffect(() => {
+    const vv = typeof window !== 'undefined' ? window.visualViewport : undefined
+    if (vv == null) return
+    const measure = (): void => {
+      const diff = window.innerHeight - vv.height - vv.offsetTop
+      setInset(diff > 0 ? Math.round(diff) : 0)
+    }
+    measure()
+    vv.addEventListener('resize', measure)
+    return () => { vv.removeEventListener('resize', measure) }
+  }, [])
+  return inset
+}
+
+/** Chat (message) icon. */
+function ChatIcon(): JSX.Element {
+  return (
+    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
+      <path d="M21 11.5a8.38 8.38 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-4.1A8.38 8.38 0 0 1 3 11.5a8.5 8.5 0 0 1 17 0Z" />
+    </svg>
+  )
+}
+
+/** Conversations (list) icon. */
+function ListIcon(): JSX.Element {
+  return (
+    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
+      <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
+    </svg>
+  )
+}
+
+/** Files (folder) icon. */
+function FilesIcon(): JSX.Element {
+  return (
+    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
+      <path d="M3 7a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
+    </svg>
+  )
+}
+
+/** Bottom-navigation item. */
+function NavItem(props: { tab: MobileTab; label: string; active: boolean; onSelect: (tab: MobileTab) => void }): JSX.Element {
+  const Icon = props.tab === 'chat' ? ChatIcon : props.tab === 'conversations' ? ListIcon : FilesIcon
+  return (
+    <button
+      type="button"
+      className={css.navItem}
+      data-active={props.active || undefined}
+      aria-current={props.active ? 'page' : undefined}
+      aria-label={props.label}
+      onClick={() => props.onSelect(props.tab)}
+    >
+      <span className={css.navIcon}><Icon /></span>
+      <span className={css.navLabel}>{props.label}</span>
+    </button>
+  )
+}
+
+/** Mobile-first tabbed shell (see module doc). */
+export function MobileFrame({
+  useStore,
+  useSessions,
+  usePanelInfo,
+  renderSlot,
+  t,
+}: AppFrameProps): JSX.Element {
+  const viewport = useStore(state => state.layoutInfo.viewportWidth)
+  const panelId = usePanelInfo(info => info.activePanelId)
+  const keyboardInset = useKeyboardInset()
+
+  // `100dvh` reflows with the soft keyboard on modern engines; fall back to
+  // subtracting the visual-viewport inset where it is unsupported, so the
+  // bottom navigation is never covered either way.
+  const [dvhSupported, setDvhSupported] = useState(true)
+  useEffect(() => {
+    if (typeof CSS === 'undefined' || typeof CSS.supports !== 'function') {
+      setDvhSupported(false)
+      return
+    }
+    setDvhSupported(CSS.supports('height', '100dvh'))
+  }, [])
+
+  const frameHeight = dvhSupported ? '100dvh' : `calc(100vh - ${keyboardInset}px)`
+
+  const [tab, setTab] = useState<MobileTab>('chat')
+
+  // Detect a session selection made from the conversations tab and return to
+  // the chat surface, so picking a conversation never leaves the list on top.
+  const activeSessionId = useSessions(state => {
+    const current = Object.values(state.byId).find(session => (session.retainedBy.mainView ?? 0) > 0)?.id
+    return current
+  })
+  const previousSession = useRef<string | undefined>(activeSessionId)
+  useEffect(() => {
+    const changed = previousSession.current !== undefined && previousSession.current !== activeSessionId
+    previousSession.current = activeSessionId
+    if (changed && tab === 'conversations') setTab('chat')
+  }, [activeSessionId, tab])
+
+  const main = renderSlot('main', {}, { entryKey: panelId ?? 'conversation' })
+  const sidebar = renderSlot('sidebar', { collapsed: false, width: viewport, drawer: true })
+  const rightbar = renderSlot('rightbar', { width: viewport, viewportWidth: viewport, canShow: true })
+  const overlays = renderSlot('shell.overlay', {})
+
+  return (
+    <div
+      className={css.frame}
+      data-mobile
+      data-tab={tab}
+      style={{ height: frameHeight } as CSSProperties}
+    >
+      <DocumentTitle useSessions={useSessions} usePanelInfo={usePanelInfo} productTitle={t('brand.localBuild')} />
+
+      <header className={css.topBar}>
+        <div className={css.title}>{t('brand.localBuild')}</div>
+      </header>
+
+      <div className={css.main}>
+        <div className={`${css.tabPane} ${css.chatPane}`} data-active={tab === 'chat' || undefined}>
+          <div className={css.mainPanel} data-global-panel={panelId !== null || undefined}>{main}</div>
+        </div>
+        <div className={css.tabPane} data-active={tab === 'conversations' || undefined}>
+          {sidebar}
+        </div>
+        <div className={css.tabPane} data-active={tab === 'files' || undefined}>
+          {rightbar}
+        </div>
+      </div>
+
+      <div className={css.overlayLayer} data-shell-overlay>
+        {overlays}
+      </div>
+
+      <nav className={css.bottomNav} aria-label={t('conversations')}>
+        <NavItem tab="conversations" label={t('conversations')} active={tab === 'conversations'} onSelect={setTab} />
+        <NavItem tab="chat" label={t('chat')} active={tab === 'chat'} onSelect={setTab} />
+        <NavItem tab="files" label={t('files')} active={tab === 'files'} onSelect={setTab} />
+      </nav>
+    </div>
+  )
+}
diff --git a/packages/client/ui-layout/src/client/RootFrame.tsx b/packages/client/ui-layout/src/client/RootFrame.tsx
new file mode 100644
index 00000000..09a0616d
--- /dev/null
+++ b/packages/client/ui-layout/src/client/RootFrame.tsx
@@ -0,0 +1,33 @@
+/**
+ * Root slot frame selector: renders the three-column {@link AppFrame} on
+ * wide/desktop viewports and the mobile-first {@link MobileFrame} on narrow
+ * ones, so a single registration serves both surfaces without forking the
+ * plugin or the engine. The switch follows a single media query; headless runs
+ * without `matchMedia` stay on the desktop frame.
+ */
+import { useSyncExternalStore } from 'react'
+import { AppFrame, type AppFrameProps } from './AppFrame.tsx'
+import { MobileFrame } from './MobileFrame.tsx'
+
+/** Viewport width at or below which the mobile shell takes over. */
+export const MOBILE_QUERY = '(max-width: 820px)'
+
+/** MatchMediaList for the mobile query, or null where matchMedia is absent. */
+const MQ: MediaQueryList | null = typeof matchMedia === 'function' ? matchMedia(MOBILE_QUERY) : null
+
+/** Subscribe to viewport changes crossing the mobile breakpoint. */
+function subscribe(listener: () => void): () => void {
+  MQ?.addEventListener('change', listener)
+  return () => { MQ?.removeEventListener('change', listener) }
+}
+
+/** Current mobile-shell state. */
+function getSnapshot(): boolean {
+  return MQ?.matches ?? false
+}
+
+/** Choose the shell for the current viewport. */
+export function RootFrame(props: AppFrameProps): JSX.Element {
+  const mobile = useSyncExternalStore(subscribe, getSnapshot, getSnapshot)
+  return mobile ? <MobileFrame {...props} /> : <AppFrame {...props} />
+}
